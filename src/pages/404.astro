---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page introuvable" description="Cette page n'existe pas ou a été déplacée.">
  <div class="conteneur erreur">
    <p class="code">404</p>
    <h1>Cette page s'est émiettée</h1>
    <p class="accroche">
      Elle n'existe pas, ou elle a été déplacée. <span>La vitrine, elle, est toujours pleine.</span>
    </p>
    <div class="actions">
      <a href="/" class="btn">Retour à l'accueil</a>
      <a href="/carte" class="btn btn-secondaire">Voir la carte</a>
    </div>
  </div>
</Layout>

<style>
  .erreur {
    min-height: 60vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
  }

  .code {
    font-family: var(--font-titre);
    font-style: italic;
    font-size: clamp(6rem, 20vw, 11rem);
    line-height: 1;
    color: var(--caramel);
  }

  .erreur h1 {
    margin-top: 0.5rem;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
  }

  .accroche {
    max-width: 32rem;
    margin: 0.75rem auto 0;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-top: 1rem;
  }

  .btn-secondaire {
    background: transparent;
    border: 2px solid var(--bordeaux);
    color: var(--bordeaux);
  }
</style>