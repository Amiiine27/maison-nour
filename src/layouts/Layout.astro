---
import "@fontsource/fraunces/400-italic.css";
import "@fontsource/fraunces/600.css";
import "@fontsource/dm-sans/400.css";
import "@fontsource/dm-sans/500.css";
import "../styles/global.css";
import Logo from "../components/Logo.astro";
import { infos } from "../data/infos";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Pâtisserie franco-orientale et salon de thé à Montreuil.",
} = Astro.props;

import Icone from "../components/Icone.astro";

const liens = [
  { href: "/", label: "Accueil", court: "Accueil", icone: "accueil" },
  { href: "/carte", label: "La carte", court: "Carte", icone: "carte" },
  {
    href: "/histoire",
    label: "Notre histoire",
    court: "Histoire",
    icone: "histoire",
  },
  { href: "/contact", label: "Contact", court: "Contact", icone: "contact" },
  {
    href: "/commande",
    label: "Commander",
    court: "Commander",
    icone: "commande",
  },
];

const actuel = Astro.url.pathname.replace(/\/$/, "") || "/";

const canonical = new URL(Astro.url.pathname, Astro.site);
const imagePartage = new URL("/images/partage.jpg", Astro.site);

const schema = {
  "@context": "https://schema.org",
  "@type": "Bakery",
  name: "Maison Nour",
  description: "Pâtisserie franco-orientale et salon de thé à Montreuil.",
  url: Astro.site?.toString(),
  telephone: infos.telephoneLien,
  image: imagePartage.toString(),
  priceRange: "€",
  servesCuisine: ["Pâtisserie française", "Pâtisserie orientale"],
  address: {
    "@type": "PostalAddress",
    streetAddress: infos.adresse,
    postalCode: infos.codePostal,
    addressLocality: infos.ville,
    addressCountry: "FR",
  },
  sameAs: [infos.instagram],
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | Maison Nour</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Maison Nour" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={`${title} | Maison Nour`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imagePartage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="robots" content="noindex" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <header>
      <a href="/"><Logo size={130} /></a>
      <nav>
        {
          liens.map((l) => (
            <a
              href={l.href}
              aria-current={actuel === l.href ? "page" : undefined}
            >
              <Icone nom={l.icone} />
              <span class="label-long">{l.label}</span>
              <span class="label-court">{l.court}</span>
            </a>
          ))
        }
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <p>{infos.adresse} · {infos.telephone}</p>
      <p><a href="/mentions-legales">Mentions légales</a></p>
    </footer>
  </body>
</html>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 1.5rem;
    background: var(--creme);
    border-bottom: 1px solid rgba(122, 46, 58, 0.15);
  }

  nav {
    display: flex;
    gap: 2rem;
  }

  nav a {
    position: relative;
    padding: 0.25rem 0;
    color: var(--bordeaux);
    text-decoration: none;
    font-weight: 500;
  }

  nav a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 2px;
    background: var(--caramel);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s ease;
  }

  nav a:hover::after,
  nav a[aria-current="page"]::after {
    transform: scaleX(1);
  }

  /* Sur ordinateur : pas d'icônes, libellés longs */
  nav :global(svg),
  .label-court {
    display: none;
  }

  footer a {
    color: var(--creme);
    text-underline-offset: 0.2em;
  }

  /* Sur mobile : barre en bas de l'écran */
  @media (max-width: 640px) {
    header {
      position: static;
      justify-content: center;
    }

    nav {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 20;
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 0.25rem;
      padding: 0.4rem 0.4rem calc(0.4rem + env(safe-area-inset-bottom));
      background: var(--creme);
      border-top: 1px solid rgba(122, 46, 58, 0.15);
      box-shadow: 0 -4px 20px rgba(43, 34, 32, 0.08);
    }

    nav a {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.2rem;
      padding: 0.4rem 0;
      font-size: 0.7rem;
      border-radius: 0.75rem;
    }

    nav a::after {
      display: none;
    }

    nav a[aria-current="page"] {
      background: var(--bordeaux);
      color: var(--creme);
    }

    nav :global(svg) {
      display: block;
      width: 1.4rem;
      height: 1.4rem;
    }

    .label-long {
      display: none;
    }

    .label-court {
      display: inline;
    }

    body {
      padding-bottom: 4.75rem;
    }
  }
</style>
