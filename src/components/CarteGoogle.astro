---
interface Props {
  adresse: string;
  titre?: string;
}

const { adresse, titre = "Plan d'accès" } = Astro.props;
const src = `https://www.google.com/maps?q=${encodeURIComponent(adresse)}&output=embed`;
---

<div class="carte-google" data-src={src} data-titre={titre}>
  <div class="carte-placeholder">
    <p class="carte-titre">Carte Google Maps</p>
    <p>En affichant la carte, vous acceptez que Google dépose des cookies sur votre appareil.</p>
    <button type="button" class="btn">Afficher la carte</button>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>(".carte-google").forEach((bloc) => {
    const bouton = bloc.querySelector("button");

    bouton?.addEventListener("click", () => {
      const iframe = document.createElement("iframe");
      iframe.src = bloc.dataset.src ?? "";
      iframe.title = bloc.dataset.titre ?? "Carte";
      iframe.referrerPolicy = "no-referrer-when-downgrade";
      bloc.replaceChildren(iframe);
    });
  });
</script>

<style>
  .carte-google {
    height: 100%;
    min-height: 24rem;
    border-radius: 1rem;
    overflow: hidden;
  }

  .carte-placeholder {
    height: 100%;
    min-height: inherit;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 2rem;
    text-align: center;
    background: #fff;
    border: 2px dashed rgba(122, 46, 58, 0.25);
    border-radius: 1rem;
  }

  .carte-titre {
    font-family: var(--font-titre);
    font-size: 1.4rem;
    color: var(--bordeaux);
  }

  .carte-placeholder p:not(.carte-titre) {
    max-width: 22rem;
    font-size: 0.9rem;
  }

  .carte-placeholder .btn {
    margin-top: 0.5rem;
    border: 0;
    font: inherit;
    font-weight: 500;
    cursor: pointer;
  }

  .carte-google :global(iframe) {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 24rem;
    border: 0;
  }

  @media (max-width: 768px) {
    .carte-google,
    .carte-google :global(iframe) {
      min-height: 18rem;
    }
  }
</style>